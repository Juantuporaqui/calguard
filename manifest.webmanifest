{
  "name": "CalGuard - Policía Científica",
  "short_name": "CalGuard",
  "description": "Cuadrante y Bitácora Operativa para Policía Científica CNP",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#0d1520",
  "theme_color": "#1a2332",
  "categories": ["productivity", "utilities"],
  "lang": "es",
  "icons": [
    {
      "src": "./icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Calendario",
      "url": "./index.html#calendar",
      "icons": [{ "src": "./icons/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Cuadrante del grupo",
      "url": "./index.html#cuadrante",
      "icons": [{ "src": "./icons/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Bitácora",
      "url": "./index.html#registry",
      "icons": [{ "src": "./icons/icon-192x192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            ".xlsx",
            ".xls",
            ".csv",
            ".pdf",
            ".json",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            "application/vnd.ms-excel",
            "application/pdf",
            "application/json",
            "text/csv"
          ]
        }
      ]
    }
  }
}
